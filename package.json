{
  "name": "wakata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wakata monorepo. The design system (DS) is the first project.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "storybook": "pnpm --filter @wakata/ds storybook",
    "build": "pnpm -r --if-present build",
    "build-storybook": "pnpm --filter @wakata/ds build-storybook",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-storybook": "10.6.3",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
